<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="openroll/projects/" />
        <include domain="file" path="openroll/journal/" />
        <include domain="file" path="openroll/versions/" />
        <include domain="file" path="openroll/state/" />
        <exclude domain="file" path="openroll/cache/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="openroll/" />
    </device-transfer>
</data-extraction-rules>
